# Copy to backend/.env and adjust. All values are optional; these are the defaults.

DATABASE_URL=sqlite:///./esg.db
# PostgreSQL later:  DATABASE_URL=postgresql+psycopg://user:pass@localhost/esg   (pip install psycopg)

# ---- Security --------------------------------------------------------------------
# Web access: normal public HTTP/HTTPS is allowed with no allowlist; localhost, private, link-local and
# cloud-metadata addresses are always blocked, also after redirects. Automatically retrieved PDFs and
# pages are held in memory only and never written to disk. See the README.
# BANK_SAFE_MODE hardens the local web server and LLM endpoint; it does not restrict web access.
BANK_SAFE_MODE=true
ENABLE_WEB_SEARCH=true
ENABLE_EXTERNAL_FETCH=true
# Manual upload only: set both of the above to false. No search or retrieval request is then made.
ENABLE_PLAYWRIGHT=false
# Resource safeguards: automatically retrieved documents (held in memory) and web pages. Over-limit documents
# are rejected, never truncated, and the analyst is told which limit. MAX_PDF_PAGES=0 means no page-count limit.
# MAX_REDIRECTS is a hop cap that also ends redirect loops.
MAX_DOWNLOAD_MB=100
MAX_HTML_SIZE_MB=10
MAX_PDF_PAGES=0
MAX_REDIRECTS=10
MAX_HTTP_RETRIES=2
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=30
MAX_SOURCE_PROCESSING_SECONDS=120
SEARCH_TIMEOUT_SECONDS=60

# ---- Network environment (corporate proxy, TLS inspection) -----------------------
# Only a proxy that you or IT already configured is used; certificates are always verified. See README
# "Managed networks". Check a computer's setup with:  python -m app.network_check
# system   : HTTPS_PROXY / HTTP_PROXY / NO_PROXY, else Windows Internet Options: the PAC script or WPAD auto-detection
#            (evaluated by Windows itself), then the static proxy
# explicit : WEB_PROXY_URL for every request, e.g. http://proxy.example.com:8080
# none     : direct connections only
WEB_PROXY_MODE=system
# WEB_PROXY_URL=
# Evaluate this PAC script instead of the one in Windows Internet Options (system mode, Windows only)
# WEB_PROXY_PAC_URL=
# none       : no proxy sign-in
# integrated : when the proxy asks (407), sign in with a Kerberos ticket from the signed-in Windows session.
#              No credentials are read or stored; NTLM is never used. Enable only with IT's approval.
WEB_PROXY_AUTH=none
# Trust the certificate authorities installed in the operating system (e.g. IT's HTTPS-inspection authority)
USE_SYSTEM_TRUST_STORE=true
# PEM file with the organisation's certificate authorities; takes precedence, also used by web search
# WEB_CA_BUNDLE=
# Stop automatic web access for an assessment after this many network failures in a row with nothing
# getting through; the analysis continues and says why. 0 = never stop early.
WEB_ACCESS_FAILURE_LIMIT=3
# true: reject all content until a scanner is registered with set_content_scanner()
MALWARE_SCAN_REQUIRED=false
# Host headers the web server answers while BANK_SAFE_MODE=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Local LLM (never a cloud API) -----------------------------------------
# llama_cpp : in-process GGUF inference (pip install -r requirements-llm.txt)
# ollama    : local Ollama server (ollama pull llama3.2:1b)
# none      : no LLM; deterministic keyword/regex extraction only
LLM_PROVIDER=llama_cpp
LOCAL_LLM_MODEL_PATH=../models/model.gguf
LLM_CONTEXT_TOKENS=4096
LLM_THREADS=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
LLM_TIMEOUT_SECONDS=180
# If the model is missing, still analyse with the keyword fallback (results flagged for review).
ALLOW_HEURISTIC_FALLBACK=true

# ---- Web discovery -------------------------------------------------------
# ddgs | duckduckgo_lite | serpapi | none. ddgs searches through the application's own transport (DuckDuckGo
# lite results) when the proxy needs integrated Windows sign-in, which the DDGS client cannot perform.
SEARCH_PROVIDER=ddgs
# SEARCH_PROVIDER=serpapi
# SERPAPI_API_KEY=
# Keyless DuckDuckGo searches are paced (seconds between queries, whole process). After the service declines or
# rate-limits automated searches, searching stops for that assessment and pauses for the cool-down; websites are
# still read. Pacing never works around a refusal: it only slows the application down.
SEARCH_MIN_INTERVAL_SECONDS=5
SEARCH_REFUSAL_COOLDOWN_SECONDS=900
MAX_SEARCH_RESULTS=10
MAX_PAGES_PER_SITE=10
# The official website (given, or the domain the identity check settled): navigation and sitemaps, robots.txt respected
WEBSITE_DISCOVERY_ENABLED=true
WEBSITE_MAX_PAGES=8
WEBSITE_MAX_PDFS=3
SITEMAP_MAX_FILES=3
MAX_DOWNLOADED_PDFS=3
# Manual uploads; automatically retrieved documents use MAX_DOWNLOAD_MB
MAX_PDF_SIZE_MB=100

# ---- Source coverage / recovery search ------------------------------------
COVERAGE_MIN_VALID_SOURCES=3
COVERAGE_MAX_FACTORS_WITHOUT_CANDIDATES=0.6
COVERAGE_MAX_COMPANY_REJECTION_SHARE=0.5
COVERAGE_MIN_REPORT_PAGE_CHARS=5000
RECOVERY_SEARCH_ENABLED=true
RECOVERY_MAX_QUERIES=10
RECOVERY_MAX_PAGES=5
RECOVERY_MAX_PDFS=2
RECOVERY_TIME_BUDGET_SECONDS=180
RECOVERY_SEARCH_PAUSE_SECONDS=1

# ---- Retrieval -----------------------------------------------------------
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=40
# passages per factor x dimension question sent to the LLM (each may be one CPU inference call)
MAX_CHUNKS_PER_QUESTION=4
HEURISTIC_CHUNKS_PER_QUESTION=10
RETRIEVAL_CANDIDATES=30
