# Copy to backend/.env and adjust. All values are optional; these are the defaults.

DATABASE_URL=sqlite:///./esg.db
# PostgreSQL later:  DATABASE_URL=postgresql+psycopg://user:pass@localhost/esg   (pip install psycopg)

# ---- Restricted security mode (BANK_SAFE_MODE) --------------------------------
# Security-hardened configuration intended to support controlled environments. It reduces technical
# risk; it does not replace organisational security review or malware scanning. See the README.
BANK_SAFE_MODE=true
ENABLE_WEB_SEARCH=true
ENABLE_EXTERNAL_FETCH=true
# Manual upload only: set both of the above to false. No search or retrieval request is then made.
ENABLE_PLAYWRIGHT=false
ALLOW_HTTP=false
# Ignored while BANK_SAFE_MODE=true: external PDFs are then never written to disk.
STORE_DOWNLOADED_FILES=false
# Comma-separated, e.g. swedbank.com,sec.gov. Empty: any host that passes the public-web checks.
ALLOWED_EXTERNAL_DOMAINS=
ALLOWED_DOMAINS_INCLUDE_SUBDOMAINS=true
MAX_DOWNLOAD_MB=20
MAX_HTML_SIZE_MB=5
MAX_PDF_PAGES=300
MAX_REDIRECTS=3
MAX_HTTP_RETRIES=2
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=30
MAX_SOURCE_PROCESSING_SECONDS=60
# true: reject all content until a scanner is registered with set_content_scanner()
MALWARE_SCAN_REQUIRED=false
# Host headers the web server answers while BANK_SAFE_MODE=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Local LLM (never a cloud API) -----------------------------------------
# llama_cpp : in-process GGUF inference (pip install -r requirements-llm.txt)
# ollama    : local Ollama server (ollama pull llama3.2:1b)
# none      : no LLM; deterministic keyword/regex extraction only
LLM_PROVIDER=llama_cpp
LOCAL_LLM_MODEL_PATH=../models/model.gguf
LLM_CONTEXT_TOKENS=4096
LLM_THREADS=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
LLM_TIMEOUT_SECONDS=180
# If the model is missing, still analyse with the keyword fallback (results flagged for review).
ALLOW_HEURISTIC_FALLBACK=true

# ---- Web discovery -------------------------------------------------------
SEARCH_PROVIDER=ddgs
# SEARCH_PROVIDER=serpapi
# SERPAPI_API_KEY=
MAX_SEARCH_RESULTS=10
MAX_PAGES_PER_SITE=10
MAX_DOWNLOADED_PDFS=3
# Manual uploads; automatically retrieved documents use MAX_DOWNLOAD_MB
MAX_PDF_SIZE_MB=50

# ---- Source coverage / recovery search ------------------------------------
COVERAGE_MIN_VALID_SOURCES=3
COVERAGE_MAX_FACTORS_WITHOUT_CANDIDATES=0.6
COVERAGE_MAX_COMPANY_REJECTION_SHARE=0.5
COVERAGE_MIN_REPORT_PAGE_CHARS=5000
RECOVERY_SEARCH_ENABLED=true
RECOVERY_MAX_QUERIES=10
RECOVERY_MAX_PAGES=5
RECOVERY_MAX_PDFS=2
RECOVERY_TIME_BUDGET_SECONDS=180
RECOVERY_SEARCH_PAUSE_SECONDS=1

# ---- Retrieval -----------------------------------------------------------
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=40
# passages per factor x dimension question sent to the LLM (each may be one CPU inference call)
MAX_CHUNKS_PER_QUESTION=4
HEURISTIC_CHUNKS_PER_QUESTION=10
RETRIEVAL_CANDIDATES=30
